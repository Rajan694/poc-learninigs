# ── Service Identity ──────────────────────────────────
SERVICE_NAME=userService
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (auth_db only) ───────────────────────────
DATABASE_URL=postgresql://postgres:password@user-db:5432/auth_db?schema=public

# ── JWT (RS256) ───────────────────────────────────────
JWT_PRIVATE_KEY_PATH=private.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
