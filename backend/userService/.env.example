# ── Service Identity ──────────────────────────────────
SERVICE_NAME=userService
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (auth_db only) ───────────────────────────
DB_HOST=user-db
DB_PORT=5432
DB_USER=postgres
DB_PASS=argusadmin
DB_NAME=auth_db
DATABASE_URL=postgresql://postgres:argusadmin@user-db:5432/auth_db?schema=public

# ── JWT (RS256) ───────────────────────────────────────
JWT_PRIVATE_KEY_PATH=private.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
