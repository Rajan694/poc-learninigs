# ── Service Identity ──────────────────────────────────
SERVICE_NAME=expenceManagerService
PORT=3003
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (expense_db only) ────────────────────────
DB_HOST=expense-db
DB_PORT=5432
DB_USER=postgres
DB_PASS=argusadmin
DB_NAME=expense_db
DATABASE_URL=postgresql://postgres:argusadmin@expense-db:5432/expense_db?schema=public

# ── JWT Verification (RS256) ──────────────────────────
JWT_PUBLIC_KEY_PATH=public.pem

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
