# ── Service Identity ──────────────────────────────────
SERVICE_NAME=expenceManagerService
PORT=3003
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (expense_db only) ────────────────────────
DATABASE_URL=postgresql://postgres:password@expense-db:5432/expense_db?schema=public

# ── JWT Verification (RS256) ──────────────────────────
JWT_PUBLIC_KEY_PATH=public.pem

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
