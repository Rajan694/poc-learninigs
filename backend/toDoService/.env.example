# ── Service Identity ──────────────────────────────────
SERVICE_NAME=toDoService
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (todo_db only) ───────────────────────────
DB_HOST=todo-db
DB_PORT=5432
DB_USER=postgres
DB_PASS=argusadmin
DB_NAME=todo_db
DATABASE_URL=postgresql://postgres:argusadmin@todo-db:5432/todo_db?schema=public

# ── JWT Verification (RS256) ──────────────────────────
JWT_PUBLIC_KEY_PATH=public.pem

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
