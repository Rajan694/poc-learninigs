# ==========================================
# Dependencies & Build Outputs (All Projects)
# ==========================================
# This ensures node_modules and builds from frontend/ and backend/ are ignored
**/node_modules/
**/dist/
**/build/
**/out/

# ==========================================
# Project Specifics
# ==========================================
# Frontend (Vite)
frontend/.vite/

# Backend
# (Add any specific backend temp files here)

# ==========================================
# Logs & Environment
# ==========================================
*.log
logs/
**/.env
**/.env.*
!**/.env.example

# ==========================================
# IDEs & OS
# ==========================================
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace

# ==========================================
# Misc
# ==========================================
.tmp/
.temp/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
